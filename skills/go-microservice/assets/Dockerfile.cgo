# syntax=docker/dockerfile:1
#
# Multi-stage build for a service that needs CGO (e.g. confluent-kafka-go / librdkafka).
# Builder: official golang image (Debian-based, so apt-get installs librdkafka-dev).
# Runtime: ubi9-minimal — NOT ubi9-micro / distroless, because those have no package manager
# and no shell, so we can't install librdkafka at runtime there. ubi9-minimal ships microdnf,
# which lets us pull in librdkafka. If we wanted a micro/distroless runtime we'd have to copy
# librdkafka.so + its transitive deps from the build stage by hand — flexible but brittle.
# Prefer the pure-Go Dockerfile + a pure-Go Kafka client (franz-go / segmentio-kafka-go)
# when feasible; only use this when CGO is unavoidable.
#
# Pin both base images to specific patch tags (or @sha256 digests) in production for
# reproducibility — floating tags drift and accumulate CVEs.

FROM golang:1.24 AS build
WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends librdkafka-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build \
      -trimpath -tags dynamic \
      -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
      -o /out/app ./cmd/myservice

# ubi9-minimal has microdnf for runtime package installs. librdkafka is not in default UBI
# repos — enable EPEL (or your internal mirror) below, or COPY librdkafka.so* from build instead.
FROM registry.access.redhat.com/ubi9-minimal:9.4
RUN rpm -i https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
 && microdnf install -y librdkafka ca-certificates \
 && microdnf clean all
COPY --from=build /out/app /usr/local/bin/app
USER 1001
EXPOSE 8080
ENTRYPOINT ["app"]
